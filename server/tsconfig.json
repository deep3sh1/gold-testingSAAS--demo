{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@goldscope/types": ["./src/types/index.js"],
      "@goldscope/shared": ["./src/shared/index.js"],
      "@goldscope/validation": ["./src/validation/index.js"]
    }
  },
  "include": ["src/**/*"]
}
