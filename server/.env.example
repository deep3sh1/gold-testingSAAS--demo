# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration (Provide your own MongoDB Atlas connection string or local MongoDB)
# For local dev without a URI, the server automatically starts a zero-config in-memory database.
MONGODB_URI=mongodb://localhost:27017/aurum_demo_db

# Authentication
JWT_SECRET=aurum-demo-super-secret-jwt-key-2026
JWT_EXPIRES_IN=7d

# WhatsApp Notifications (mock / cloud_api / twilio)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=test_request_update
